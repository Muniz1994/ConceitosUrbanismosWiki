---
import Base from '@/layouts/Base.astro';
import { t } from '@/i18n/pt-PT';
import { carregarGrafo } from '@/lib/colecao';
import { FONTE } from '@/lib/fonte';
import { url } from '@/lib/url';
import { ArrowRight, Info, Network } from 'lucide-react';
import PesquisaInicio from '@/components/PesquisaInicio';

const { conceitos } = await carregarGrafo();
const anexos = (['I', 'II'] as const).map((anexo) => ({
  anexo,
  titulo: t.anexo[anexo],
  descricao: anexo === 'I' ? t.anexo.descricaoI : t.anexo.descricaoII,
  total: conceitos.filter((c) => c.anexo === anexo).length,
}));
---
<Base seccao="inicio">
  <div class="mx-auto max-w-3xl">
    <p class="mb-3 text-sm text-muted-foreground">{FONTE.titulo}, de {FONTE.data}</p>
    {/*
      Introdução: em ecrãs estreitos (< 640 px) fica dobrada atrás de um ícone de informação no título
      (<details> nativo: funciona sem JavaScript e anuncia aberto/fechado). Em ecrãs largos, mostra-se sempre.
      Só uma das duas versões está visível de cada vez, por isso os leitores de ecrã leem o texto uma vez.
    */}
    <div class="relative">
      <h1 class="pr-12 text-3xl font-semibold tracking-tight text-balance sm:pr-0 sm:text-4xl">{t.inicio.titulo}</h1>
      <details class="sm:hidden" data-introducao-dobravel>
        <summary
          class="absolute top-0 right-0 grid size-10 cursor-pointer list-none place-items-center rounded-full text-info transition-colors hover:bg-accent [&::-webkit-details-marker]:hidden"
        >
          <Info className="size-6" aria-hidden="true" />
          <span class="sr-only">{t.inicio.mostrarIntroducao}</span>
        </summary>
        <p class="mt-4 text-lg text-pretty text-muted-foreground">{t.inicio.introducao}</p>
      </details>
    </div>
    <p class="mt-4 hidden text-lg text-pretty text-muted-foreground sm:block" data-introducao-larga>{t.inicio.introducao}</p>

    <div class="relative z-10 mt-8" role="search">
      <PesquisaInicio client:load />
      <p class="mt-2 text-sm text-muted-foreground">{t.pesquisa.dica}</p>
    </div>

    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {
        anexos.map((a) => (
          <a
            href={`${url('indice/')}?anexo=${a.anexo}`}
            class="group rounded-xl border bg-card p-5 transition-colors hover:bg-accent"
            data-contagem-anexo={a.anexo}
          >
            <div class="flex items-center gap-2 text-sm font-medium">
              <span class:list={['size-2.5 rounded-full', a.anexo === 'I' ? 'bg-anexo-i' : 'bg-anexo-ii']} aria-hidden="true" />
              {a.titulo}
            </div>
            <p class="mt-2 text-3xl font-semibold tabular-nums">
              {a.total}
              <span class="text-base font-normal text-muted-foreground"> conceitos</span>
            </p>
            <p class="mt-2 text-sm text-muted-foreground">{a.descricao}</p>
          </a>
        ))
      }
    </div>

    <div class="mt-6 flex flex-wrap gap-3">
      <a href={url('indice/')} class="inline-flex h-10 items-center gap-2 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/90">
        {t.inicio.explorarIndice}
        <ArrowRight className="size-4" aria-hidden="true" />
      </a>
      <a href={url('grafo/')} class="inline-flex h-10 items-center gap-2 rounded-md border px-4 text-sm font-medium hover:bg-accent">
        <Network className="size-4" aria-hidden="true" />
        {t.inicio.explorarGrafo}
      </a>
    </div>
  </div>
</Base>
