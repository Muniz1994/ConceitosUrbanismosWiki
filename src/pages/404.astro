---
import Base from '@/layouts/Base.astro';
import { t } from '@/i18n/pt-PT';
import { url } from '@/lib/url';
import { Search } from 'lucide-react';
---
<Base seccao="outra" titulo={t.naoEncontrado.titulo}>
  <div class="mx-auto max-w-xl py-12 text-center">
    <p class="text-sm font-medium text-muted-foreground">404</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight">{t.naoEncontrado.titulo}</h1>
    <p class="mt-4 text-muted-foreground">{t.naoEncontrado.texto}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <button
        type="button"
        data-abrir-pesquisa
        class="inline-flex h-10 items-center gap-2 rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground hover:bg-primary/90"
      >
        <Search className="size-4" aria-hidden="true" />
        {t.pesquisa.abrir}
      </button>
      <a href={url('indice/')} class="inline-flex h-10 items-center rounded-md border px-4 text-sm font-medium hover:bg-accent">
        {t.nav.indice}
      </a>
    </div>
  </div>
</Base>
