---
import GrafoSvg from '@/components/GrafoSvg.astro';
import Base from '@/layouts/Base.astro';
import { t } from '@/i18n/pt-PT';
import { carregarGrafoCompleto } from '@/lib/colecao';

const disposicao = await carregarGrafoCompleto();
---
<Base seccao="grafo" titulo={t.grafo.titulo} descricao={t.grafo.descricao}>
  <div class="mx-auto max-w-6xl">
    <h1 class="text-3xl font-semibold tracking-tight">{t.grafo.titulo}</h1>
    <p class="mt-2 mb-6 max-w-3xl text-muted-foreground">{t.grafo.descricao}</p>
    <GrafoSvg disposicao={disposicao} variante="completo" rotulo={t.grafo.titulo} />
  </div>
</Base>
