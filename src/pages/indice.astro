---
import Base from '@/layouts/Base.astro';
import { t } from '@/i18n/pt-PT';
import { carregarGrafo } from '@/lib/colecao';
import { agruparPorLetra, resumo } from '@/lib/indice';
import { urlConceito } from '@/lib/url';

const { conceitos } = await carregarGrafo();
const grupos = agruparPorLetra(conceitos);
const total = conceitos.length;
---
<Base seccao="indice" titulo={t.indice.titulo} descricao={t.indice.descricao}>
  <div class="mx-auto max-w-4xl">
    <h1 class="text-3xl font-semibold tracking-tight">{t.indice.titulo}</h1>
    <p class="mt-2 text-muted-foreground">{t.indice.descricao}</p>

    <div class="sticky top-14 z-10 -mx-4 mt-6 border-b bg-background/95 px-4 py-3 backdrop-blur sm:mx-0 sm:px-0" data-filtros>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
        <div role="group" aria-label={t.pesquisa.filtroAnexo} class="inline-flex rounded-lg border p-0.5">
          {
            [
              ['todos', t.pesquisa.todos],
              ['I', t.anexo.I],
              ['II', t.anexo.II],
            ].map(([valor, rotulo]) => (
              <button
                type="button"
                data-filtro-anexo={valor}
                aria-pressed={valor === 'todos' ? 'true' : 'false'}
                class="rounded-md px-3 py-1 text-sm text-muted-foreground transition-colors hover:text-foreground aria-pressed:bg-accent aria-pressed:font-medium aria-pressed:text-foreground"
              >
                {rotulo}
              </button>
            ))
          }
        </div>
        <label class="inline-flex cursor-pointer items-center gap-2 text-sm">
          <input type="checkbox" data-filtro-abreviatura class="size-4 accent-primary" />
          {t.indice.comAbreviatura}
        </label>
        <p class="ml-auto text-sm text-muted-foreground tabular-nums" aria-live="polite" data-contagem>
          {t.indice.mostrando(total, total)}
        </p>
      </div>
      <nav aria-label={t.indice.letras} class="mt-3 flex flex-wrap gap-1">
        {
          grupos.map((g) => (
            <a href={`#letra-${g.letra}`} data-salto-letra={g.letra} class="grid size-7 place-items-center rounded text-sm font-medium hover:bg-accent">
              {g.letra}
            </a>
          ))
        }
      </nav>
    </div>

    <p class="mt-8 hidden text-muted-foreground" data-nenhum>{t.indice.nenhum}</p>

    {
      grupos.map((g) => (
        <section class="mt-8" aria-labelledby={`letra-${g.letra}`} data-grupo-letra={g.letra}>
          <h2 id={`letra-${g.letra}`} class="scroll-mt-40 border-b pb-1 text-xl font-semibold">
            {g.letra}
          </h2>
          <ul class="divide-y">
            {g.conceitos.map((c) => (
              <li data-entrada data-anexo={c.anexo} data-tem-abreviatura={c.abreviatura ? 'sim' : 'nao'} class="py-3">
                <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
                  <a href={urlConceito(c.slug)} data-conceito={c.slug} class="font-medium hover:underline">
                    {c.conceito}
                  </a>
                  {c.abreviatura && (
                    <span class="rounded border px-1.5 text-xs font-semibold" title={t.conceito.abreviatura}>
                      {c.abreviatura}
                    </span>
                  )}
                  <span class="ml-auto inline-flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class:list={['size-1.5 rounded-full', c.anexo === 'I' ? 'bg-anexo-i' : 'bg-anexo-ii']} aria-hidden="true" />
                    {t.anexo[c.anexo]} · {c.ficha}
                  </span>
                </div>
                <p class="mt-1 text-sm text-muted-foreground">{resumo(c.definicao)}</p>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>

<script>
  import { t } from '@/i18n/pt-PT';

  const botoesAnexo = [...document.querySelectorAll<HTMLButtonElement>('[data-filtro-anexo]')];
  const caixaAbreviatura = document.querySelector<HTMLInputElement>('[data-filtro-abreviatura]')!;
  const entradas = [...document.querySelectorAll<HTMLElement>('[data-entrada]')];
  const grupos = [...document.querySelectorAll<HTMLElement>('[data-grupo-letra]')];
  const contagem = document.querySelector<HTMLElement>('[data-contagem]')!;
  const nenhum = document.querySelector<HTMLElement>('[data-nenhum]')!;

  const parametros = new URLSearchParams(location.search);
  let anexo = ['I', 'II'].includes(parametros.get('anexo') ?? '') ? parametros.get('anexo')! : 'todos';
  caixaAbreviatura.checked = parametros.get('abreviatura') === 'sim';

  function aplicar() {
    let visiveis = 0;
    for (const e of entradas) {
      const mostrar =
        (anexo === 'todos' || e.dataset.anexo === anexo) &&
        (!caixaAbreviatura.checked || e.dataset.temAbreviatura === 'sim');
      e.hidden = !mostrar;
      if (mostrar) visiveis++;
    }
    for (const g of grupos) {
      const vazio = !g.querySelector('[data-entrada]:not([hidden])');
      g.hidden = vazio;
      document.querySelector<HTMLElement>(`[data-salto-letra="${g.dataset.grupoLetra}"]`)!.hidden = vazio;
    }
    for (const b of botoesAnexo) b.setAttribute('aria-pressed', String(b.dataset.filtroAnexo === anexo));
    contagem.textContent = t.indice.mostrando(visiveis, entradas.length);
    nenhum.hidden = visiveis > 0;
    nenhum.classList.toggle('hidden', visiveis > 0);

    const url = new URL(location.href);
    if (anexo === 'todos') url.searchParams.delete('anexo');
    else url.searchParams.set('anexo', anexo);
    if (caixaAbreviatura.checked) url.searchParams.set('abreviatura', 'sim');
    else url.searchParams.delete('abreviatura');
    history.replaceState(null, '', url);
  }

  for (const b of botoesAnexo) {
    b.addEventListener('click', () => {
      anexo = b.dataset.filtroAnexo!;
      aplicar();
    });
  }
  caixaAbreviatura.addEventListener('change', aplicar);
  aplicar();
</script>
